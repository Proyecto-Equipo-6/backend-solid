{
  "info": {
    "name": "Remates el Paisa - Backend API",
    "description": "Colección completa organizada por Casos de Uso.\n\nFlujo: Login → Copiar token cookie → Probar rutas.\nRequiere variable de entorno: baseUrl (default http://localhost:3000).\n\nRoles:\n- Admin: require cookie token + id_rol=1\n- Cliente: require cookie token + id_rol=2\n- Repartidor: require cookie token + id_rol=3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "CU-002 Registrar Cuenta",
      "item": [
        {
          "name": "Registrar cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Retorna id y datos', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('id_usuario');",
                  "  pm.expect(json).to.have.property('email');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre_apellido\": \"Juan Pérez\",\n  \"tipo_documento\": \"CC\",\n  \"numero_documento\": \"1020304050\",\n  \"email\": \"juan@email.com\",\n  \"password\": \"Admin123\",\n  \"telefono\": \"3001234567\",\n  \"direccion\": \"Calle 10 #5-20, Medellín\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "CU-003 Iniciar Sesión",
      "item": [
        {
          "name": "Login (guarda cookie token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Retorna usuario', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('usuario');",
                  "  pm.expect(json.usuario).to.have.property('id_rol');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"juan@email.com\",\n  \"password\": \"Admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "logout"
              ]
            }
          }
        }
      ]
    },
